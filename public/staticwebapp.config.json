{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{css,js,png,gif,jpg,jpeg,svg,ico,webmanifest,json,woff,woff2,map,txt}"]
  },
  "routes": [
    {
      "route": "/index.html",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }
    },
    {
      "route": "/sw.js",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }
    },
    {
      "route": "/registerSW.js",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }
    },
    {
      "route": "/manifest.webmanifest",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }
    }
  ]
}
